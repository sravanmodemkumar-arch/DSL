  {
    "id": "q-time-work-full",
    "meta": {
      "subject": "Mathematics",
      "topic": "Arithmetic",
      "subtopic": "Time and Work",
      "difficulty": "medium"
    },
    "assets": {
      "images": {
        "workers": "/assets/images/workers.png"
      },
      "svgs": {
        "work_flow": "/assets/svg/work-flow.svg"
      }
    },
    "scenes": [
      {
        "type": "question",
        "text": "A can complete a work in 10 days and B in 15 days. In how many days can they complete together?",
        "audio": "A can complete a work in ten days and B in fifteen days. In how many days can they complete the work together?",
        "render": {
          "action": "show",
          "target": "question_block"
        }
      },
      {
        "type": "visual_intro",
        "render": {
          "action": "show",
          "target": "image",
          "src": "workers",
          "position": "center",
          "size": "medium"
        }
      },
      {
        "type": "concept",
        "steps": [
          {
            "text": "Work formula",
            "audio": "In time and work, we calculate work done per day",
            "render": {
              "action": "show",
              "target": "formula_block",
              "value": "Work per day = 1 / total days"
            }
          },
          {
            "text": "Combined work",
            "audio": "When two people work together, we add their efficiencies",
            "render": {
              "action": "highlight",
              "target": "formula_block"
            }
          }
        ]
      },
      {
        "type": "solution",
        "steps": [
          {
            "text": "A's work",
            "audio": "A completes the work in ten days, so A's one day work is one by ten",
            "render": {
              "action": "show",
              "target": "equation",
              "value": "A = 1/10"
            }
          },
          {
            "text": "B's work",
            "audio": "B completes the work in fifteen days, so B's one day work is one by fifteen",
            "render": {
              "action": "show",
              "target": "equation",
              "value": "B = 1/15"
            }
          },
          {
            "text": "Show flow",
            "audio": "Now we combine both works",
            "render": {
              "action": "show",
              "target": "svg",
              "src": "work_flow",
              "position": "center",
              "size": "medium"
            }
          },
          {
            "text": "Add fractions",
            "audio": "Now we add one by ten and one by fifteen",
            "render": {
              "action": "show",
              "target": "equation",
              "value": "1/10 + 1/15"
            }
          },
          {
            "text": "LCM step",
            "audio": "The LCM of ten and fifteen is thirty",
            "render": {
              "action": "highlight",
              "target": "equation"
            }
          },
          {
            "text": "Convert fractions",
            "audio": "One by ten becomes three by thirty and one by fifteen becomes two by thirty",
            "render": {
              "action": "update",
              "target": "equation",
              "value": "3/30 + 2/30"
            }
          },
          {
            "text": "Add",
            "audio": "Now we add three by thirty and two by thirty which gives five by thirty",
            "render": {
              "action": "update",
              "target": "equation",
              "value": "5/30"
            }
          },
          {
            "text": "Simplify",
            "audio": "Five by thirty simplifies to one by six",
            "render": {
              "action": "update",
              "target": "equation",
              "value": "1/6"
            }
          },
          {
            "text": "Final",
            "audio": "This means together they complete the work in six days",
            "render": {
              "action": "show_result",
              "target": "final_answer",
              "value": "6 days"
            }
          }
        ]
      }
    ]
  },
