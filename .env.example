# ─────────────────────────────────────────────────────────────────
#  STEM Video Generator — Environment Configuration Template
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key

# ── Video Defaults ────────────────────────────────────────────────
DEFAULT_RESOLUTION=1080p
DEFAULT_QUALITY_PRESET=P5
DEFAULT_THEME=dark
DEFAULT_FPS=30

# ── TTS (Text-to-Speech) ──────────────────────────────────────────
TTS_ENGINE=edge_tts
TTS_LANG=en
TTS_VOICE=en-IN-PrabhatNeural

# ── Background Music ──────────────────────────────────────────────
BGM_ENABLED=true
BGM_STYLE=lotus
BGM_VOLUME=0.30

# ── Watermark ─────────────────────────────────────────────────────
WATERMARK_ENABLED=false
WATERMARK_TEXT=
WATERMARK_OPACITY=0.35

# ── Worker Settings ───────────────────────────────────────────────
MAX_WORKERS=4
JOB_TIMEOUT=600
