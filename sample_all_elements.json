  {
    "id": "q-math-percentage-basics",
    "thumbnail_intro_seconds": 3,
    "thumbnail": {
      "title": "Percentage — Quick Maths",
      "subtitle": "Formula · Digit Method · Fraction",
      "badge": "SSC | Banking | Railway",
      "topic": "Percentage Shortcut",
      "highlights": ["Formula card", "Digit boxes", "Fraction result"],
      "style": "dark"
    },
    "meta": {
      "subject": "Mathematics",
      "topic": "Percentage",
      "subtopic": "Basic percentage calculation",
      "difficulty": "easy",
      "exam": "SSC / Banking / Railway",
      "grade": "Class 7 to Competitive Exams",
      "language": "English"
    },
    "question": {
      "text": "What is 15% of 240?",
      "audio": "What is fifteen percent of two hundred and forty?",
      "options": [
        { "key": "a", "value": "30" },
        { "key": "b", "value": "36" },
        { "key": "c", "value": "40" },
        { "key": "d", "value": "45" }
      ],
      "correct": "b"
    },
    "scenes": [
      {
        "type": "question",
        "text": "What is 15% of 240?",
        "audio": "What is fifteen percent of two forty? Percentage means per hundred. So fifteen percent means fifteen out of every hundred parts.",
        "render": { "action": "show", "target": "question_block" }
      },
      {
        "type": "options",
        "audio": "Option A thirty. Option B thirty six. Option C forty. Option D forty five. Think before you scroll.",
        "render": { "action": "show", "target": "options_grid" }
      },
      {
        "type": "concept",
        "steps": [
          {
            "text": "Percentage Formula",
            "audio": "The percentage formula is: Percentage equals value divided by total, multiplied by one hundred. Or reversed: value equals percentage divided by one hundred, multiplied by total.",
            "render": {
              "action": "show",
              "target": "formula_block",
              "value": "Value = (Percent ÷ 100) × Total"
            }
          },
          {
            "text": "Apply the formula",
            "audio": "Apply the formula. Value equals fifteen divided by one hundred, multiplied by two forty.",
            "render": {
              "action": "show",
              "target": "equation",
              "value": "= (15 ÷ 100) × 240"
            }
          },
          {
            "text": "Simplify fraction",
            "audio": "Fifteen divided by one hundred simplifies to three over twenty.",
            "render": {
              "action": "show",
              "target": "fraction",
              "numerator": "15",
              "denominator": "100",
              "result": "3/20",
              "label": "Simplify",
              "highlighted": false
            }
          },
          {
            "text": "Final calculation",
            "audio": "Now multiply three over twenty by two forty. Three times two forty is seven twenty. Seven twenty divided by twenty is thirty six.",
            "render": {
              "action": "show",
              "target": "equation",
              "value": "3/20 × 240 = 720/20 = 36"
            }
          },
          {
            "text": "Answer = 36",
            "audio": "The answer is thirty six. Option B is correct.",
            "render": {
              "action": "show",
              "target": "sum_box",
              "value": "36",
              "highlighted": true
            }
          },
          {
            "text": "Number line — 15% is between 10% and 20%",
            "audio": "On the number line, fifteen percent lies exactly between ten percent and twenty percent of two forty.",
            "render": {
              "action": "show",
              "target": "number_line",
              "label": "Percentage on number line (0–100%)",
              "start": 0,
              "end": 100,
              "marks": [0, 10, 15, 20, 50, 100],
              "highlight": [15]
            }
          }
        ]
      }
    ]
  },

