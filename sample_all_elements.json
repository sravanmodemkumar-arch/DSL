    "scenes": [
      {
        "type": "question",
        "text": "When an acid reacts with a base, what type of reaction occurs?",
        "audio": "When an acid reacts with a base, what type of reaction occurs? This is a fundamental chemistry concept.",
        "render": { "action": "show", "target": "question_block" }
      },
      {
        "type": "options",
        "audio": "Option A oxidation. Option B reduction. Option C neutralisation. Option D decomposition.",
        "render": { "action": "show", "target": "options_grid" }
      },
      {
        "type": "concept",
        "steps": [
          {
            "text": "The Golden Rule",
            "audio": "The golden rule: Acid plus Base gives Salt and Water. This is called Neutralisation.",
            "render": {
