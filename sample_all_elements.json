    },
    "question": {
      "text": "Which gas is released as a by-product of photosynthesis?",
      "audio": "Which gas is released as a by-product of photosynthesis?",
      "options": [
        { "key": "a", "value": "CO₂" },
        { "key": "b", "value": "N₂" },
        { "key": "c", "value": "O₂" },
        { "key": "d", "value": "H₂" }
      ],
      "correct": "c"
    },
    "scenes": [
      {
        "type": "question",
        "text": "Which gas is released as a by-product of photosynthesis?",
        "audio": "Which gas is released as a by-product of photosynthesis? By-product means something produced along with the main product. Let us understand the photosynthesis process first.",
        "render": { "action": "show", "target": "question_block" }
      },
      {
        "type": "options",
        "audio": "Option A carbon dioxide. Option B nitrogen. Option C oxygen. Option D hydrogen. One of these is what plants release into the air.",
        "render": { "action": "show", "target": "options_grid" }
      },
      {
        "type": "concept",
        "steps": [
          {
            "text": "What is Photosynthesis?",
            "audio": "Photosynthesis is the process by which green plants prepare their own food using sunlight, carbon dioxide, and water.",
            "render": {
              "action": "show",
              "target": "concept_text",
              "heading": "Photosynthesis",
              "items": [
                "Plants make food using sunlight.",
                "Inputs: CO₂ + H₂O + Light energy.",
                "Site: Chloroplasts (contain chlorophyll).",
                "Output: Glucose (C₆H₁₂O₆) + Oxygen"
              ]
            }
          },
          {
            "text": "Process Steps",
            "audio": "The process has three main steps. First, chlorophyll absorbs sunlight. Second, light energy splits water into hydrogen and oxygen. Third, carbon dioxide is combined with hydrogen to form glucose.",
            "render": {
              "action": "show",
              "target": "process_steps",
              "heading": "Process",
              "steps": [
                "Chlorophyll absorbs sunlight",
                "Water (H₂O) splits → H + O₂ released",
                "CO₂ + H → Glucose (C₆H₁₂O₆)"
              ]
            }
          },
          {
            "text": "Photosynthesis Flow",
            "audio": "The flow of photosynthesis: sunlight enters the leaf, chlorophyll captures it, water and carbon dioxide are absorbed, glucose and oxygen are produced.",
            "render": {
              "action": "show",
              "target": "flow_chart",
              "heading": "Photosynthesis Flow",
              "steps": [
                { "text": "Sunlight absorbed by Chlorophyll", "color": "orange" },
                { "text": "H₂O absorbed from roots", "color": "blue" },
                { "text": "CO₂ enters through stomata", "color": "green" },
                { "text": "Glucose produced + O₂ released", "color": "green" }
              ]
            }
          },
          {
            "text": "Chemical Equation",
            "audio": "The balanced chemical equation of photosynthesis is: six molecules of carbon dioxide plus six molecules of water, in the presence of light and chlorophyll, produces one molecule of glucose and six molecules of oxygen.",
            "render": {
              "action": "show",
              "target": "chem_equation",
              "reactants": "6CO₂ + 6H₂O",
              "products": "C₆H₁₂O₆ + 6O₂",
              "conditions": "Sunlight + Chlorophyll",
              "reversible": false
            }
          },
          {
            "text": "Key Facts",
            "audio": "Key facts to remember. Chlorophyll gives plants their green color. Stomata are tiny pores through which gases enter. Photosynthesis happens mainly in leaves.",
            "render": {
              "action": "show",
              "target": "key_facts",
              "heading": "Quick Facts",
              "facts": [
                { "key": "Site",        "value": "Chloroplasts in leaf cells" },
                { "key": "Pigment",     "value": "Chlorophyll (green)" },
                { "key": "Gas In",      "value": "CO₂ (through stomata)" },
                { "key": "Gas Out",     "value": "O₂ (by-product)" },
                { "key": "Food Made",   "value": "Glucose (C₆H₁₂O₆)" }
              ]
            }
          },
          {
            "text": "Memory Trick",
            "audio": "Remember using the mnemonic CLOG. Carbon dioxide, Light, Oxygen, Glucose. That is the input output pair of photosynthesis.",
            "render": {
              "action": "show",
              "target": "memory_trick",
              "label": "Remember photosynthesis as:",
              "trick": "CLOG",
              "expansion": "CO₂  Light  O₂  Glucose",
              "note": "CO₂ + Light → O₂ + Glucose"
            }
          },
          {
            "text": "Answer: Oxygen",
            "audio": "Oxygen is released as a by-product when water molecules are split during photosynthesis. Option C is correct.",
            "render": { "action": "show", "target": "final_answer" }
          }
        ]
      }
    ]
  },

