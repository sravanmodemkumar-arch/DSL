            }
          },
          {
            "text": "Neutralisation Explained",
            "audio": "In a neutralisation reaction, the H plus ions from the acid combine with the O H minus ions from the base to form water. The remaining ions form a salt.",
            "render": {
              "action": "show",
              "target": "concept_text",
              "heading": "Neutralisation",
              "items": [
                "H⁺ (from acid) + OH⁻ (from base) → H₂O",
                "Remaining ions form a Salt",
                "Product is always neutral (pH = 7)",
                "Exothermic — releases heat"
              ]
            }
          },
          {
            "text": "Example Reaction — HCl + NaOH",
            "audio": "Example: Hydrochloric acid plus sodium hydroxide gives sodium chloride plus water. HCl plus NaOH gives NaCl plus H two O.",
            "render": {
              "action": "show",
              "target": "chem_equation",
              "reactants": "HCl + NaOH",
              "products": "NaCl + H₂O",
              "conditions": "Neutralisation",
              "reversible": false
            }
          },
          {
            "text": "pH Scale Key Points",
            "audio": "Key pH facts: acids have pH less than seven. Neutral substances have pH exactly seven. Bases have pH greater than seven.",
            "render": {
              "action": "show",
              "target": "key_facts",
              "heading": "pH Scale",
              "facts": [
                { "key": "Acid",    "value": "pH < 7  (e.g. HCl, H₂SO₄)" },
                { "key": "Neutral", "value": "pH = 7  (e.g. Water, NaCl)" },
                { "key": "Base",    "value": "pH > 7  (e.g. NaOH, NH₃)" },
                { "key": "Product", "value": "Salt + Water (always)" }
              ]
            }
          }
        ]
      }
    ]
